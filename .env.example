# Supabase project URL (Project Settings → API). Local: printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (or the legacy "anon" key). Safe to expose to the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or the legacy "service_role" key). Server-only: used to record graded submissions and to seed.
SUPABASE_SECRET_KEY=

# Local development only: GitHub OAuth app credentials read by supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

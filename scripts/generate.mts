// Builds src/generated/: the grader's sandbox runtime as one script, and every problem's starter, solution, and test
// sources. Runs before dev, build, and test, so generated code always matches the sources it came from.
import { mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
import { join, relative } from "node:path";
import { build } from "esbuild";

const root = process.cwd();
const outDir = join(root, "src/generated");
mkdirSync(outDir, { recursive: true });

const bundle = await build({
  entryPoints: [join(root, "src/grader/sandbox/runtime.js")],
  bundle: true,
  write: false,
  format: "iife",
  platform: "neutral",
  mainFields: ["module", "main"],
  target: "es2022",
  minifyWhitespace: true,
  minifySyntax: true,
  define: { "process.env.NODE_ENV": '"development"' },
  // linkedom's package exports hide this module; a file path resolves to the same instance linkedom uses internally.
  alias: { "linkedom-register-html-class": "./node_modules/linkedom/esm/shared/register-html-class.js" },
  logLevel: "error",
});
writeFileSync(
  join(outDir, "grader-runtime.ts"),
  `// Generated by scripts/generate.mts. Do not edit.\nexport default ${JSON.stringify(bundle.outputFiles[0].text)};\n`,
);

function readTree(dir: string, base = dir): Record<string, string> {
  const files: Record<string, string> = {};
  for (const name of readdirSync(dir)) {
    const path = join(dir, name);
    if (statSync(path).isDirectory()) {
      Object.assign(files, readTree(path, base));
    } else {
      files[`/${relative(base, path).replaceAll("\\", "/")}`] = readFileSync(path, "utf8").replaceAll("\r\n", "\n");
    }
  }
  return files;
}

const problemsDir = join(root, "content/problems");
const sources: Record<string, { starter: Record<string, string>; solution: Record<string, string>; tests: string }> =
  {};
for (const id of readdirSync(problemsDir).sort()) {
  const dir = join(problemsDir, id);
  if (!statSync(dir).isDirectory()) continue;
  sources[id] = {
    starter: readTree(join(dir, "starter")),
    solution: readTree(join(dir, "solution")),
    tests: readFileSync(join(dir, "tests.jsx"), "utf8").replaceAll("\r\n", "\n"),
  };
}
writeFileSync(
  join(outDir, "problem-sources.ts"),
  `// Generated by scripts/generate.mts. Do not edit.\nexport const PROBLEM_SOURCES: Record<string, { starter: Record<string, string>; solution: Record<string, string>; tests: string }> = ${JSON.stringify(sources, null, 1)};\n`,
);
